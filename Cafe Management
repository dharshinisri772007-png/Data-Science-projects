import pandas as pd
import matplotlib.pyplot as plt
from io import StringIO

df = pd.read_csv(StringIO(data))

df.to_csv("cafe_management.csv", index=False)

print("CSV file created successfully!")
print("Rows:", df.shape[0])
print("Columns:", df.shape[1])

display(df.head())

print("\n===== DATASET INFORMATION =====")
print("Shape:", df.shape)
print("Columns:", df.columns.tolist())

print("\n===== DATA TYPES =====")
print(df.dtypes)

print("\n===== STATISTICAL SUMMARY =====")
display(df.describe())

print("\n===== DUPLICATES =====")
print("Duplicate rows:", df.duplicated().sum())



print("\n===== MEAN =====")
print("Age:", round(df["Age"].mean(), 2))
print("Quantity:", round(df["Quantity"].mean(), 2))
print("Unit Price:", round(df["Unit_Price"].mean(), 2))
print("Total Amount:", round(df["Total_Amount"].mean(), 2))
print("Satisfaction:", round(df["Satisfaction"].mean(), 2))


print("\n===== STANDARD DEVIATION =====")
print("Age:", round(df["Age"].std(), 2))
print("Quantity:", round(df["Quantity"].std(), 2))
print("Unit Price:", round(df["Unit_Price"].std(), 2))
print("Total Amount:", round(df["Total_Amount"].std(), 2))
print("Satisfaction:", round(df["Satisfaction"].std(), 2))


print("\n===== SALES =====")
print("Total Revenue: ₹", df["Total_Amount"].sum())



sales = df.groupby("Item")["Total_Amount"].sum().sort_values(ascending=False)

plt.figure(figsize=(10,5))
sales.plot(kind="bar")
plt.title("Cafe Sales by Item")
plt.xlabel("Item")
plt.ylabel("Total Sales (₹)")
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()



payment = df["Payment_Method"].value_counts()

plt.figure(figsize=(7,7))
payment.plot(
    kind="pie",
    autopct="%1.1f%%",
    startangle=90
)
plt.title("Payment Method Distribution")
plt.ylabel("")
plt.show()



day_order = [
    "Monday", "Tuesday", "Wednesday",
    "Thursday", "Friday", "Saturday", "Sunday"
]

daily_sales = (
    df.groupby("Visit_Day")["Total_Amount"]
    .sum()
    .reindex(day_order)
)

plt.figure(figsize=(9,5))
plt.plot(
    daily_sales.index,
    daily_sales.values,
    marker="o"
)
plt.title("Cafe Sales by Day")
plt.xlabel("Visit Day")
plt.ylabel("Total Sales (₹)")
plt.xticks(rotation=45)
plt.grid(True)
plt.tight_layout()
plt.show()


plt.figure(figsize=(8,5))

plt.hist(
    df["Age"],
    bins=8
)

plt.title("Customer Age Distribution")
plt.xlabel("Age")
plt.ylabel("Number of Customers")
plt.grid(axis="y")
plt.show()


plt.figure(figsize=(8,5))

plt.scatter(
    df["Quantity"],
    df["Total_Amount"]
)

plt.title("Quantity vs Total Amount")
plt.xlabel("Quantity")
plt.ylabel("Total Amount (₹)")
plt.grid(True)
plt.show()

import matplotlib.pyplot as plt

plt.figure(figsize=(7, 5))

plt.boxplot(df["Total_Amount"])

plt.title("Box Plot of Total Amount")
plt.ylabel("Total Amount (₹)")
plt.grid(axis="y")

plt.show()

# Heatmap
numeric_data = df[[
    "Age",
    "Quantity",
    "Unit_Price",
    "Total_Amount",
    "Satisfaction"
]]

correlation = numeric_data.corr()

plt.figure(figsize=(8, 6))
plt.imshow(correlation, cmap="coolwarm", interpolation="nearest")

plt.colorbar()

plt.xticks(
    range(len(correlation.columns)),
    correlation.columns,
    rotation=45
)

plt.yticks(
    range(len(correlation.columns)),
    correlation.columns
)

plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()
